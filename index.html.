<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>FoundHome demo</title>
<style>
:root{--bg:#EEF2F0;--card:#fff;--ink:#16262E;--mut:#5C6C72;--line:#CBD5D2;--acc:#0E7C86;--brass:#C8963E;--ok:#1E7A46;--bad:#B3261E;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0F1B20;--card:#17262D;--ink:#E7EEEC;--mut:#9DB0B5;--line:#2B3F47;--acc:#4FC1CB;--ok:#5FD08B;--bad:#FF8A80}}
*{box-sizing:border-box}html{color-scheme:light dark}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}
h1,h2{font-family:Georgia,serif;margin:0}h1{font-size:26px;letter-spacing:-.3px}h2{font-size:18px}
header{padding:20px 20px 8px;max-width:1100px;margin:auto}header p{margin:4px 0 0;color:var(--mut)}
main{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:16px;padding:12px 20px 40px;max-width:1100px;margin:auto}
@media(max-width:820px){main{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
#stage{position:relative;width:100%;aspect-ratio:16/10;border-radius:10px;overflow:hidden;background:#d9d2c5;touch-action:none;user-select:none}
#stage>img,#stage>svg.room{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#gap{position:absolute;border:2px dashed var(--brass);background:rgba(200,150,62,.12);border-radius:4px;pointer-events:none}
#gaplbl{position:absolute;font-size:12px;font-weight:600;color:#7a5a1c;background:#fff9;padding:0 6px;border-radius:4px;pointer-events:none}
#item{position:absolute;cursor:grab;filter:drop-shadow(0 6px 6px rgba(0,0,0,.28))}#item:active{cursor:grabbing}#item svg{display:block;width:100%;height:100%}
#item.bad{outline:2px solid var(--bad);outline-offset:3px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}label{font-size:14px;color:var(--mut)}
input[type=text],input[type=number],select{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);min-width:0}
input[type=text]{flex:1}input[type=number]{width:84px}input[type=range]{flex:1;accent-color:var(--acc)}
button{font:inherit;padding:8px 14px;border-radius:8px;border:1px solid var(--acc);background:var(--acc);color:#fff;cursor:pointer;font-weight:600}
button.ghost{background:transparent;color:var(--acc)}button:focus-visible,input:focus-visible,select:focus-visible,.li:focus-visible{outline:3px solid var(--brass);outline-offset:2px}
#list{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.li{border:1px solid var(--line);border-radius:10px;padding:8px;cursor:pointer;background:var(--bg);text-align:left;color:var(--ink);font-weight:400}
.li[aria-pressed=true]{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc)}.li b{display:block;font-size:14px}.li span{font-size:13px;color:var(--mut)}
.li svg{width:100%;height:46px;margin-bottom:4px}
#verdict{border-radius:10px;padding:12px;font-weight:600;border:1px solid var(--line)}#verdict.ok{border-color:var(--ok);color:var(--ok)}#verdict.bad{border-color:var(--bad);color:var(--bad)}
#verdict small{display:block;font-weight:400;color:var(--ink);margin-top:4px}
#msg{font-size:14px;color:var(--mut);min-height:21px;margin:0}.chips{display:flex;gap:6px;flex-wrap:wrap}.chips button{padding:5px 12px;font-weight:500}
.chips button[aria-pressed=true]{background:var(--acc);color:#fff}.chips button[aria-pressed=false]{background:transparent;color:var(--acc)}
.stack>*+*{margin-top:14px}.note{font-size:13px;color:var(--mut)}
</style></head><body>
<header><h1>FoundHome</h1><p>Paste a furniture link, drop it in your room, and see whether it fits before you drive over.</p></header>
<main>
<section class="card" aria-label="Your room">
<div id="stage"><svg class="room" id="sample" viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" aria-label="Sample living room"><rect width="160" height="100" fill="#D8D0C2"/><rect y="74" width="160" height="26" fill="#A98B6A"/><rect y="73" width="160" height="2" fill="#8E7355"/><rect x="108" y="14" width="34" height="40" fill="#BFD9E4" stroke="#F4F1EA" stroke-width="2.5"/><path d="M125 14v40M108 34h34" stroke="#F4F1EA" stroke-width="1.5"/><rect x="26" y="80" width="70" height="14" rx="2" fill="#8FA7A3" opacity=".6"/></svg>
<div id="gap"></div><div id="gaplbl"></div><div id="item" role="img" aria-label="Furniture preview, drag to move"></div></div>
<p class="note">Drag the furniture. The dashed box is the open space you want to fill. Sizes are drawn to scale.</p>
<div class="row"><label for="up">Your room photo</label><input id="up" type="file" accept="image/*"><button class="ghost" id="reset">Use sample room</button></div>
<div class="row"><label for="wall">Wall width in photo (in)</label><input id="wall" type="number" value="180" min="60" max="400"><label for="space">Open space (in)</label><input id="space" type="number" value="90" min="12" max="300"></div>
<div class="row"><label>Room style</label><div class="chips" id="styles"></div></div>
</section>
<section class="stack">
<div class="card"><h2>Paste a furniture link</h2><div class="row"><input id="url" type="text" placeholder="https://… couch, chair, desk, shelf" aria-label="Furniture link"><button id="go">Visualize</button></div><p id="msg" aria-live="polite"></p></div>
<div class="card"><h2>Nearby listings</h2><div class="row"><div id="list" style="width:100%"></div></div></div>
<div class="card"><div id="verdict" aria-live="polite"></div>
<div class="row"><label><input type="checkbox" id="promo" onchange="verdict()"> Seller promotes this listing (5% ad rate)</label></div><div class="row"><label><input type="checkbox" id="pair" onchange="verdict()"> Buyer adds a partner item: <span id="pairname"></span></label></div><p class="note" id="price"></p><p class="note" id="earn"></p></div>
</section></main>
<script>
const $=id=>document.getElementById(id);
const ITEMS=[
{id:'sofa',kw:/sofa|couch|loveseat|sectional/,name:'Gray loveseat',w:72,h:33,d:35,price:140,style:'Modern',col:'#6E7F86'},
{id:'chair',kw:/chair|armchair|recliner/,name:'Rust accent chair',w:30,h:34,d:32,price:65,style:'Boho',col:'#B5603A'},
{id:'shelf',kw:/shelf|shelving|bookcase|book/,name:'Oak bookcase',w:32,h:72,d:12,price:55,style:'Classic',col:'#8A6A44'},
{id:'desk',kw:/desk|table|dining/,name:'Steel-leg desk',w:54,h:30,d:26,price:80,style:'Industrial',col:'#4A4F55'}];
const NEAR={Modern:['Industrial'],Industrial:['Modern'],Classic:['Boho'],Boho:['Classic']};
let cur=ITEMS[0],style='Modern',pos={x:.35,y:null};
function art(it){const w=it.w,h=it.h,c=it.col,dk='rgba(0,0,0,.28)';let b='';
if(it.id==='sofa')b=`<rect x="0" y="${h*.12}" width="${w}" height="${h*.68}" rx="4" fill="${c}"/><rect x="${w*.08}" y="${h*.45}" width="${w*.84}" height="${h*.35}" rx="3" fill="${dk}"/><path d="M${w/2} ${h*.45}v${h*.35}" stroke="${dk}"/><rect x="${w*.06}" y="${h*.8}" width="3" height="${h*.2}" fill="#3a2a1c"/><rect x="${w*.94-3}" y="${h*.8}" width="3" height="${h*.2}" fill="#3a2a1c"/>`;
if(it.id==='chair')b=`<rect x="${w*.1}" y="0" width="${w*.8}" height="${h*.55}" rx="5" fill="${c}"/><rect x="0" y="${h*.4}" width="${w}" height="${h*.4}" rx="4" fill="${c}"/><rect x="${w*.15}" y="${h*.5}" width="${w*.7}" height="${h*.2}" fill="${dk}"/><rect x="${w*.12}" y="${h*.8}" width="3" height="${h*.2}" fill="#3a2a1c"/><rect x="${w*.88-3}" y="${h*.8}" width="3" height="${h*.2}" fill="#3a2a1c"/>`;
if(it.id==='shelf'){b=`<rect width="${w}" height="${h}" fill="${c}"/>`;for(let i=1;i<5;i++)b+=`<rect x="2" y="${h*i/5-1}" width="${w-4}" height="2" fill="${dk}"/><rect x="${3+i*2}" y="${h*i/5-9}" width="${5+i}" height="8" fill="${i%2?'#d9c9a3':'#6f8a8c'}"/>`}
if(it.id==='desk')b=`<rect y="0" width="${w}" height="${h*.12}" rx="2" fill="${c==='#4A4F55'?'#B9926A':c}"/><rect x="2" y="${h*.12}" width="3" height="${h*.88}" fill="${c}"/><rect x="${w-5}" y="${h*.12}" width="3" height="${h*.88}" fill="${c}"/><rect x="2" y="${h*.78}" width="${w-4}" height="2" fill="${c}"/>`;
return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">${b}</svg>`}
function build(){$('list').innerHTML='';ITEMS.forEach(it=>{const b=document.createElement('button');b.className='li';b.setAttribute('aria-pressed',it===cur);b.innerHTML=`<svg viewBox="0 0 ${it.w} ${it.h}">${art(it).replace(/<\/?svg[^>]*>/g,'')}</svg><b>${it.name}</b><span>$${it.price} · ${it.w}×${it.d}×${it.h} in</span>`;b.onclick=()=>{cur=it;$('msg').textContent='';render(true)};$('list').appendChild(b)});
$('styles').innerHTML='';Object.keys(NEAR).forEach(s=>{const b=document.createElement('button');b.textContent=s;b.setAttribute('aria-pressed',s===style);b.onclick=()=>{style=s;build();verdict()};$('styles').appendChild(b)})}
function ppi(){return $('stage').clientWidth/Math.max(1,+$('wall').value)}
function render(reset){const st=$('stage'),k=ppi(),W=st.clientWidth,H=st.clientHeight,floor=H*.84,sp=+$('space').value*k;
const g=$('gap');g.style.width=sp+'px';g.style.left=(W*.3)+'px';g.style.height=Math.min(cur.h*k,floor-6)+'px';g.style.top=(floor-Math.min(cur.h*k,floor-6))+'px';
$('gaplbl').textContent=$('space').value+' in open';$('gaplbl').style.left=(W*.3+4)+'px';$('gaplbl').style.top=(floor-Math.min(cur.h*k,floor-6)-22)+'px';
const it=$('item');it.style.width=cur.w*k+'px';it.style.height=cur.h*k+'px';it.innerHTML=art(cur);
if(reset||pos.y===null){pos.x=W*.3+(sp-cur.w*k)/2;pos.y=floor-cur.h*k}
it.style.left=pos.x+'px';it.style.top=pos.y+'px';verdict()}
function verdict(){const sp=+$('space').value,spare=sp-cur.w,v=$('verdict'),k=ppi(),W=$('stage').clientWidth;
const left=parseFloat($('gap').style.left),inside=pos.x>=left-cur.w*k*.15&&pos.x+cur.w*k<=left+sp*k+cur.w*k*.15;
const door=Math.min(cur.d,cur.w)<=30?'Gets through a standard 30 in door.':'Measure your doorway: this piece is wide on every side.';
const sm=cur.style===style?'Strong style match':NEAR[style].includes(cur.style)?'Works with your '+style+' room':'Clashes with a '+style+' room';
const ok=spare>=0;$('item').classList.toggle('bad',!ok);v.className=ok?'ok':'bad';
v.innerHTML=(ok?(spare<3?'Tight fit. '+spare+' in to spare':'Fits. '+spare+' in to spare'):'Too wide by '+(-spare)+' in')+`<small>${cur.name}: ${cur.w} in wide in a ${sp} in space. ${door} ${sm}.</small>`;
const PAIR={sofa:['5×8 rug',300],chair:['floor lamp',120],shelf:['storage baskets',90],desk:['desk lamp',60]},pr=PAIR[cur.id],pro=$('promo').checked,pa=$('pair').checked;$('pairname').textContent=pr[0]+' $'+pr[1]+' (sample partner)';const fee=cur.price*.10,ad=pro?cur.price*.05:0,pc=pa?pr[1]*.06:0;$('price').textContent=`Buyer pays $${cur.price+(pa?pr[1]:0)}. Seller keeps $${(cur.price-fee-ad).toFixed(2)}.`;$('earn').textContent=`FoundHome earns $${(fee+ad+pc).toFixed(2)} here: $${fee.toFixed(2)} fee + $${ad.toFixed(2)} promoted + $${pc.toFixed(2)} partner. Our model averages $18.66 on a $150 order.`}
function fromUrl(){let u=$('url').value.trim();if(!u)return $('msg').textContent='Paste a link to a couch, chair, desk or bookshelf.';
let host='that site',t=u.toLowerCase();try{host=new URL(/^https?:/.test(u)?u:'https://'+u).hostname.replace(/^www\./,'')}catch(e){return $('msg').textContent='That doesn’t look like a link. Try one that starts with https://'}
const m=ITEMS.find(i=>i.kw.test(t));cur=m||ITEMS[0];$('msg').textContent=m?`Imported from ${host}: ${m.name}, ${m.w}×${m.d}×${m.h} in. (Prototype uses sample dimensions.)`:`Couldn’t read a furniture type from ${host}, so we’re showing a sample ${cur.name.toLowerCase()}.`;build();render(true)}
let drag=null;const it=$('item');
it.addEventListener('pointerdown',e=>{drag={dx:e.clientX-pos.x,dy:e.clientY-pos.y};it.setPointerCapture(e.pointerId)});
it.addEventListener('pointermove',e=>{if(!drag)return;const st=$('stage'),k=ppi();pos.x=Math.max(0,Math.min(st.clientWidth-cur.w*k,e.clientX-drag.dx));pos.y=Math.max(0,Math.min(st.clientHeight-cur.h*k,e.clientY-drag.dy));it.style.left=pos.x+'px';it.style.top=pos.y+'px';verdict()});
it.addEventListener('pointerup',()=>drag=null);
$('go').onclick=fromUrl;$('url').addEventListener('keydown',e=>{if(e.key==='Enter')fromUrl()});
['wall','space'].forEach(i=>$(i).addEventListener('input',()=>render(i==='space')));
$('up').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{let im=$('stage').querySelector('img');if(!im){im=document.createElement('img');im.alt='Your room';$('stage').prepend(im)}im.src=r.result;$('sample').style.display='none'};r.readAsDataURL(f)};
$('reset').onclick=()=>{const im=$('stage').querySelector('img');if(im)im.remove();$('sample').style.display='';$('up').value=''};
new ResizeObserver(()=>render(false)).observe($('stage'));build();render(true);
</script></body></html>
